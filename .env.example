# Postgres connection string (Vercel/Neon injects this automatically once you
# attach a Postgres database to your Vercel project; for local dev, create a
# free database at https://neon.tech or https://vercel.com/storage/postgres
# and paste its connection string here).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The shared password used to log into the app.
APP_PASSWORD=change-me

# Random secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too
